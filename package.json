{
  "name": "craft-overlay",
  "version": "0.1.0",
  "private": true,
  "description": "Path of Exile 2 overlay helper (MVP: item text parser)",
  "author": "ggwpaspera-main",
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "parse": "tsx src/cli.ts",
    "filter:priors": "node scripts/build-filter-priors.mjs",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run typecheck",
    "build": "node scripts/build.mjs",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "allowScripts": [
    "esbuild",
    "electron",
    "uiohook-napi",
    "koffi"
  ],
  "devDependencies": {
    "@types/node": "*",
    "electron": "*",
    "electron-builder": "*",
    "esbuild": "*",
    "tsx": "*",
    "typescript": "*",
    "vitest": "*"
  },
  "build": {
    "appId": "com.craftoverlay.app",
    "productName": "Craft Overlay",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "out/**/*",
      "package.json",
      "THIRD-PARTY-NOTICES.md",
      "third-party-licenses/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "craft-overlay-${version}.exe"
    }
  },
  "dependencies": {
    "koffi": "^2.15.2",
    "uiohook-napi": "^1.5.5"
  }
}
